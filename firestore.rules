rules_version = '2';

// The landing page writes to the waitlist using the Firebase Admin SDK
// (server-side), which bypasses these rules. This file locks the collection
// down so nothing can be read or written from untrusted clients.
service cloud.firestore {
  match /databases/{database}/documents {
    match /waitlist/{doc} {
      allow read, write: if false;
    }
  }
}
